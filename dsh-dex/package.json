{
  "name": "dsh-dex",
  "version": "0.1.0",
  "description": "DeepSeek Harness Dex OIDC login and per-user session/workspace isolation",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cookie.js",
    "scripts/check-core-release.mjs",
    "cordis.patch.yml",
    "README.md",
    "test/*.test.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check index.js",
    "test": "npm run check:compat && node --test test/*.test.js",
    "check:compat": "node scripts/check-core-release.mjs",
    "pack:release": "npm pack"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.1",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.1-rc.1",
    "zod": ">=4.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  }
}
